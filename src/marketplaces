export async function testHepsiburadaConnection() {
  const username = process.env.HEPSIBURADA_USERNAME;
  const password = process.env.HEPSIBURADA_PASSWORD;
  const merchantId = process.env.HEPSIBURADA_MERCHANT_ID;

  if (!username || !password || !merchantId) {
    return {
      ok: false,
      status: 'not_configured',
      message: 'Hepsiburada API bilgileri henüz girilmedi.'
    };
  }

  return {
    ok: false,
    status: 'not_verified',
    message: 'API bilgileri mevcut. Gerçek bağlantı testi henüz uygulanmadı.'
  };
}

