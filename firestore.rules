rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['REPLACE_WITH_ADMIN_EMAIL'];
    }

    match /dealer_applications/{applicationId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'company', 'phone', 'email', 'city', 'message', 'status', 'created_at'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5
        && request.resource.data.phone.size() <= 30
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time
        && (!('company' in request.resource.data) || request.resource.data.company == null || request.resource.data.company.size() <= 160)
        && (!('email' in request.resource.data) || request.resource.data.email == null || request.resource.data.email.size() <= 254)
        && (!('city' in request.resource.data) || request.resource.data.city == null || request.resource.data.city.size() <= 100)
        && (!('message' in request.resource.data) || request.resource.data.message == null || request.resource.data.message.size() <= 2000);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
